# LaTeX build artefacts (scoped to tex/ so that numerical outputs in results/ are never
# swallowed; results/*.out is explicitly un-ignored below)
tex/*.aux
tex/*.bbl
tex/*.blg
tex/*.fdb_latexmk
tex/*.fls
tex/*.log
tex/*.out
tex/*.synctex.gz
tex/*.toc
tex/*.nav
tex/*.snm
tex/*.vrb
!results/*.out

# The final compiled PDF is tracked (issue #12); rebuild artefacts above stay ignored.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store

# Large downloaded sources — keep notes in lit/notes/ instead
lit/pdf/

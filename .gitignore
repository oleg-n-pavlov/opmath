# LaTeX build artefacts (scoped to tex/ so that numerical outputs in results/ are never
# swallowed; results/*.out is explicitly un-ignored below)
tex/*.aux
tex/*.bbl
tex/*.blg
tex/*.fdb_latexmk
tex/*.fls
tex/*.log
tex/*.out
tex/*.synctex.gz
tex/*.toc
tex/*.nav
tex/*.snm
tex/*.vrb
!results/*.out

# Deliberate choice (issue #3, coordinator note): the compiled PDF is NOT tracked during
# development to avoid a large binary diff on every commit; issue #12 will remove this line and
# commit the final PDF, as its acceptance criteria require.
tex/main.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store

# Large downloaded sources — keep notes in lit/notes/ instead
lit/pdf/
